        {
            color: #0089d2;
            font-weight: bold;
            line-height: 18px;
            padding-left: 2px;
            text-align: left;
        }
        .Prev, .Nxt
        {
            background: none repeat scroll 0 0 #8596a5;
            cursor: default;
            float: left;
            height: 15px;
            margin-right: 1px;
            position: relative;
            width: 15px;
        }
        .Prev span, .Nxt span
        {
            display: block;
            height: 0;
            position: absolute;
            top: 2px;
            width: 0;
        }
        .Prev span
        {
            border-bottom: 5px solid transparent;
            border-right: 5px solid #FFFFFF;
            border-top: 5px solid transparent;
            left: 5px;
        }
        .Nxt span
        {
            border-bottom: 5px solid transparent;
            border-left: 5px solid #FFFFFF;
            border-top: 5px solid transparent;
            right: 4px;
        }
        .Prev:hover, .Nxt:hover, .Prev.PNActive, .Nxt.PNActive
        {
            background: none repeat scroll 0 0 #0a81c0;
        }
        .Green_Page
        {
            color: #0a81c0;
        }
