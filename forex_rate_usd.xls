<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1"><title>
	:: Knowledge Portal ::
</title>
    <style type="text/css">
        body
        {
            margin: 0;
            padding: 0;
            font-family: 'PT Sans' , sans-serif;
            color: #686868;
            font-size: 13px;
        }
        
        
        .GridHeadLeft_Fin
        {
            background-color: #dadfe3;
            background-position: center center;
            background-repeat: repeat-x;
            border-left: 1px solid #585858;
            border-right: 1px solid #585858;
            border-bottom: 1px solid #585858;
            color: #000000;
            font-size: 11px;
            height: 26px;
            padding-left: 10px;
            text-align: left;
            text-decoration: none;
        }
        
        .GridHeadCenter_Fin
        {
            background-color: #dadfe3;
            background-position: center center;
            background-repeat: repeat-x;
            border-right: 1px solid #585858;
            border-bottom: 1px solid #585858;
            color: #000000;
            font-size: 11px;
            height: 26px;
            padding-left: 5px;
            padding-right: 5px;
            text-align: center;
            text-decoration: none;
        }
        
        .GridHeadRight_Fin
        {
            background-color: #dadfe3;
            background-position: center center;
            background-repeat: repeat-x;
            border-right: 1px solid #585858;
            border-bottom: 1px solid #585858;
            color: #000000;
            font-size: 11px;
            height: 26px;
            padding-left: 5px;
            padding-right: 5px;
            text-align: right;
            text-decoration: none;
        }
        
        .GridDataRight_Alt
        {
            border-bottom: 1px solid #585858;
            border-right: 1px solid #585858;
            color: #585858;
            cursor: default;
            font-size: 11px;
            line-height: 20px;
            padding-right: 10px;
            text-align: right;
        }
        .GridDataLeft_Alt
        {
            border-bottom: 1px solid #585858;
            border-left: 1px solid #585858;
            border-right: 1px solid #585858;
            color: #585858;
            cursor: default;
            font-size: 11px;
            line-height: 20px;
            padding-right: 10px;
            text-align: left;
            padding-left: 10px;
        }
        .GridDataCenter_Alt
        {
            border-bottom: 1px solid #585858;
            border-style: none;
            color: #585858;
            cursor: default;
            font-size: 11px;
            line-height: 20px;
            padding-right: 10px;
            text-align: center;
        }
        
        .GridDataRight
        {
            border-bottom: 1px solid #585858;
            border-right: 1px solid #585858;
            color: #323131;
            cursor: default;
            font-size: 11px;
            font-weight: normal;
            padding-right: 10px;
            text-align: right;
            line-height: 32px;
        }
        .GridDataCenter
        {
            border-bottom: 1px solid #585858;
            color: #323131;
            cursor: default;
            font-size: 11px;
            font-weight: normal;
            padding-right: 10px;
            text-align: center;
            line-height: 32px;
        }
        .GridDataLeft
        {
            border-right: 1px solid #585858;
            border-bottom: 1px solid #585858;
            border-left: 1px solid #585858;
            color: #323131;
            cursor: default;
            font-size: 11px;
            font-weight: normal;
            padding-left: 10px;
            text-align: left;
            line-height: 32px;
        }
        
        .DropDown
        {
            background: none repeat scroll 0 0 #F7FBFD;
            border: 1px solid #D2D8DE;
            line-height: 20px;
            width: 85px;
        }
        .btnGo_Css
        {
            background-color: #009EF3;
            border: medium none;
            color: #FFFFFF;
            cursor: pointer;
            font-family: Arial,Verdana;
            font-size: 12px;
            height: 20px;
            width: 26px;
            text-align: center;
            vertical-align: middle;
        }
        
        .NewsTime
        {
            border-bottom: 1px solid #585858;
            color: #17a7f4;
            font-weight: normal;
            line-height: 22px;
        }
        .NewsHeading
        {
            border-bottom: 1px solid #585858;
            color: #737373;
            font-weight: normal;
            line-height: 22px;
            padding-left: 7px;
            text-align: left;
        }
        .HomeNewsHead
        {
            color: #0089D2;
            font-weight: bold;
            line-height: 18px;
            padding-left: 7px;
            text-align: left;
        }
        .HomeNewsDate
        {
            color: #0089D2;
            font-weight: bold;
            line-height: 25px;
            padding-left: 7px;
            text-align: left;
            text-decoration: none;
        }
        a.NewsHeading, a.NewsHeading:link, a.NewsHeading:visited, a.NewsHeading:active, a.NewsHeading:focus
        {
            color: #737373;
            font-weight: normal;
            text-decoration: none;
        }
        .Newsdate
        {
            border-bottom: 1px solid #585858;
            color: #066192;
            font-weight: normal;
            line-height: 22px;
            padding-left: 7px;
            text-align: left;
            text-decoration: none;
        }
        .NoData
        {
            color: #FF0000;
            font-size: 12px;
            font-weight: bold;
            text-align: center;
        }
        .NewsDetails
        {
            color: #4e4f50;
            font-weight: normal;
            padding-left: 5px;
            line-height: 22px;
            text-align: justify;
            text-decoration: none;
        }
        .NewsHeadingDate
        {
            color: #0089d2;
            font-weight: bold;
            line-height: 18px;
            padding-left: 2px;
            text-align: left;
        }
        .Prev, .Nxt
        {
            background: none repeat scroll 0 0 #8596a5;
            cursor: default;
            float: left;
            height: 15px;
            margin-right: 1px;
            position: relative;
            width: 15px;
        }
        .Prev span, .Nxt span
        {
            display: block;
            height: 0;
            position: absolute;
            top: 2px;
            width: 0;
        }
        .Prev span
        {
            border-bottom: 5px solid transparent;
            border-right: 5px solid #FFFFFF;
            border-top: 5px solid transparent;
            left: 5px;
        }
        .Nxt span
        {
            border-bottom: 5px solid transparent;
            border-left: 5px solid #FFFFFF;
            border-top: 5px solid transparent;
            right: 4px;
        }
        .Prev:hover, .Nxt:hover, .Prev.PNActive, .Nxt.PNActive
        {
            background: none repeat scroll 0 0 #0a81c0;
        }
        .Green_Page
        {
            color: #0a81c0;
        }
        .HeadBox
        {
            background: none repeat scroll 0 0 #009EF3;
            color: #FFFFFF;
            font-weight: normal;
            margin-bottom: 3px;
            padding: 6px 0 6px 12px;
        }
        .ContentBox
        {
            background-color: #FFFFFF;
            border: 1px solid #D4D4D4;
            line-height: 22px;
            padding: 10px;
        }
        .NewsContentBox
        {
            background-color: #FFFFFF;
            border-bottom: 1px solid #D4D4D4;
            border-left: 1px solid #D4D4D4;
            border-right: 1px solid #D4D4D4;
            line-height: 22px;
            padding: 10px;
        }
        .MoreNews
        {
            color: #066192;
            font-size: 12px;
            text-align: left;
            text-transform: uppercase;
        }
        a.MoreNews:link, a.MoreNews:visited, a.MoreNews:active, a.MoreNews:focus, a.MoreNews:hover
        {
            color: #066192;
            cursor: pointer;
            font-size: 12px;
            text-decoration: none;
        }
        .CursorHand
        {
            cursor: pointer;
        }
        .CursorMove
        {
            cursor: move;
        }
        .HLinkcontainer ul
        {
            list-style-type: none;
            margin: 0;
            padding: 0 0 0 5px;
        }
        .HLinkcontainer ul li
        {
            line-height: 22px;
            list-style-type: none;
        }
        .HLinkcontainer ul li a:link, .HLinkcontainer ul li a:visited, .HLinkcontainer ul li a:active
        {
            color: #8C9197;
            text-decoration: none;
        }
        .HLinkcontainer ul li a:hover
        {
            color: #066192;
            text-decoration: none;
        }
        
        
        .Css_BreadCrumb
        {
            color: #686868;
            text-decoration: none;
            font-size: 13px;
        }
        .Css_BreadCrumb a:link, .Css_BreadCrumb a:visited, .Css_BreadCrumb a:active
        {
            color: #686868;
            text-decoration: none;
        }
        
        input[type="radio"]
        {
            background: none;
            border: none;
            width: 20px;
        }
    </style>
</head>
